{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "qbabel Quantum Intermediate Representation",
  "description": "Language-neutral circuit IR used by qbabel. See json_example style: qubits, gates with controls and parameters, and measurements.",
  "type": "object",
  "required": [
    "ir_version",
    "program"
  ],
  "additionalProperties": false,
  "properties": {
    "ir_version": {
      "type": "string"
    },
    "program": {
      "$ref": "#/definitions/program"
    }
  },
  "definitions": {
    "qubit_ref": {
      "type": "string",
      "pattern": "^q[0-9]+$"
    },
    "bit_ref": {
      "type": "string",
      "pattern": "^c[0-9]+$"
    },
    "identifier": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "parameter": {
      "type": "object",
      "required": [
        "expression",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "expression": {
          "type": "string"
        },
        "type": {
          "enum": [
            "float",
            "int",
            "symbol"
          ]
        }
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "type",
        "name",
        "targets"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "gate"
        },
        "name": {
          "type": "string"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/qubit_ref"
          }
        },
        "controls": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/qubit_ref"
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/parameter"
          }
        }
      }
    },
    "measure": {
      "type": "object",
      "required": [
        "type",
        "qubits",
        "results"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "measure"
        },
        "qubits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/qubit_ref"
          }
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/bit_ref"
          }
        }
      }
    },
    "operation": {
      "anyOf": [
        {
          "$ref": "#/definitions/gate"
        },
        {
          "$ref": "#/definitions/measure"
        }
      ]
    },
    "program": {
      "type": "object",
      "required": [
        "name",
        "qubits",
        "operations"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "qubits": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/identifier"
          }
        },
        "classical_bits": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/identifier"
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/operation"
          }
        }
      }
    }
  }
}
